# Transmission RPC 端点（默认 http://localhost:9091/transmission/rpc）
TR_URL=http://localhost:9091/transmission/rpc

# RPC 认证（若 Transmission 未开启认证可留空）
TR_USER=admin
TR_PASS=password

# 本服务监听端口
SERVER_PORT=8200

# WebSocket 轮询间隔
POLL_INTERVAL=2s

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# 宿主平台：generic（默认，Docker / 物理机 / 任意 Linux）| fnos（飞牛应用）
# 留空时自动推断：配置了 GATEWAY_PREFIX 或检测到 TRIM_APPDEST 即判定为 fnos
TM_PLATFORM=generic

# 接口访问令牌；非回环地址监听时必填，为空表示不启用鉴权
# API_TOKEN=
